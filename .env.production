# The deployed site's configuration. Committed, and read by `npm run build`
# (Vite loads `.env.production` in production mode, on top of `.env`), so a
# build made on master gets this file whether or not a `.env` is present.
#
# How the files layer, in Vite's order (later wins):
#
#   .env                  your machine, gitignored  — local play, real key
#   .env.production       this file, committed      — the deployed baseline
#   .env.production.local gitignored                — private build overrides
#   process environment   the deploy workflow       — GitHub repository
#                                                     variables win over all
#
# `npm run dev` never reads this file. `npm run build` always does, which is
# the point: the real key in your `.env` is replaced by the placeholder below
# before anything is bundled, so a production build never inlines it.
#
# Never put a real value in VITE_ANTHROPIC_API_KEY here. Vite inlines VITE_*
# variables into the public bundle, and the app treats exactly this
# placeholder as "no key". Generation on the deployed site goes through the
# proxy named by VITE_ANTHROPIC_PROXY_URL instead (see worker/README.md).
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here
VITE_ANTHROPIC_WORKSPACE_ID=

# Public Firebase web config. Blank here on purpose: the deploy workflow in
# .github/workflows/deploy.yml supplies the real values from repository
# variables, which override this file. Fill them in only if you build and
# host the site somewhere without that workflow (Docker, Cloud Run).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Must be blank in a deployed build; an emulator host here would point every
# visitor at a database on your laptop.
VITE_FIREBASE_EMULATOR_HOST=

# The generation proxy. Also supplied by the workflow from a repository
# variable; set it here only for a build made outside GitHub Actions.
VITE_ANTHROPIC_PROXY_URL=
