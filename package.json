{
    "name": "omnitrivia",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "check-deps": "node scripts/check-deps.mjs",
        "predev": "node scripts/check-deps.mjs",
        "dev": "vite",
        "predev:lan": "node scripts/check-deps.mjs",
        "dev:lan": "vite --host 0.0.0.0",
        "predev:local": "node scripts/check-deps.mjs",
        "dev:local": "vite --host localhost",
        "prebuild": "node scripts/check-deps.mjs",
        "build": "tsc && vite build",
        "prepreview": "node scripts/check-deps.mjs",
        "preview": "vite preview --host 0.0.0.0",
        "pretypecheck": "node scripts/check-deps.mjs",
        "typecheck": "tsc --noEmit",
        "precheck-key": "node scripts/check-deps.mjs",
        "check-key": "node scripts/check-key.mjs",
        "pregenerate-questions": "node scripts/check-deps.mjs",
        "generate-questions": "node scripts/generate-questions.mjs",
        "emulators": "npx --yes firebase-tools@latest emulators:start --only database,auth --project omnitrivia-local",
        "rules:login": "npx --yes firebase-tools@latest login",
        "rules:deploy": "npx --yes firebase-tools@latest deploy --only database",
        "check-room-rules": "node scripts/check-room-rules.mjs",
        "check-room-join": "node scripts/check-room-join.mjs",
        "check-round-pacing": "node scripts/check-round-pacing.mjs",
        "check-game-setup": "node scripts/check-game-setup.mjs",
        "check-live": "node scripts/check-live.mjs",
        "worker:dev": "npx --yes wrangler@latest dev --config worker/wrangler.toml --port 8787 --local",
        "worker:deploy": "npx --yes wrangler@latest deploy --config worker/wrangler.toml",
        "worker:login": "npx --yes wrangler@latest login",
        "worker:secret": "npx --yes wrangler@latest secret put ANTHROPIC_API_KEY --config worker/wrangler.toml",
        "worker:tail": "npx --yes wrangler@latest tail --config worker/wrangler.toml",
        "check-proxy-auth": "node scripts/check-proxy-auth.mjs",
        "check-proxy-gates": "node scripts/check-proxy-gates.mjs"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.122.0",
        "firebase": "^12.19.0",
        "framer-motion": "^10.16.16",
        "lucide-react": "^0.303.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-qr-code": "^2.0.12",
        "zod": "^4.5.1"
    },
    "devDependencies": {
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^4.2.1",
        "typescript": "^5.3.3",
        "vite": "^5.0.12"
    },
    "engines": {
        "node": ">=18"
    }
}
