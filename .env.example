# Copy to .env and fill in your own values. .env is gitignored.
# Create a key at https://console.anthropic.com/settings/keys
#
# WARNING: Vite inlines VITE_* variables into the public JS bundle at build
# time. Anyone who loads the site — including any device on the same Wi-Fi as a
# LAN-bound dev server — can read this key and spend against your Anthropic
# account. Scope it to a low spend limit, or skip it entirely and import your
# questions from CSV (see QUESTION_FORMAT.md), which needs no key at all.
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Only needed for identity-linked keys, which are rejected with
# "anthropic-workspace-id is required" unless the request names a workspace.
# Find it in the Console URL when viewing the workspace. Leave blank otherwise.
VITE_ANTHROPIC_WORKSPACE_ID=

# --- Multiplayer -----------------------------------------------------------
# Firebase Realtime Database is what lets phones in the room join the host's
# game. Leave these blank and the app still runs, but joining only works
# between windows of one browser. See MULTIPLAYER.md for the 10-minute setup.
#
# These five are NOT secrets. A Firebase web config identifies the project and
# is readable in any browser that loads the app; the database rules in
# firebase/database.rules.json are what actually protect a room.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Point the app at a local emulator instead of the real project. Leave blank
# unless you are running `npm run emulators`.
VITE_FIREBASE_EMULATOR_HOST=

# --- Question generation on a deployed site --------------------------------
# A server that holds the Anthropic key so this bundle does not have to. Set
# this and VITE_ANTHROPIC_API_KEY above is not used at all: requests go to the
# proxy, which checks the caller's Firebase sign-in and adds the real key.
# See worker/README.md. Leave blank for local play, where the key in .env is
# read directly and never leaves your machine.
VITE_ANTHROPIC_PROXY_URL=
