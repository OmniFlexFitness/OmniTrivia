# Copy to .env and fill in your own values. .env is gitignored.
# Create a key at https://console.anthropic.com/settings/keys
#
# WARNING: Vite inlines VITE_* variables into the public JS bundle at build
# time. Anyone who loads the site — including any device on the same Wi-Fi as a
# LAN-bound dev server — can read this key and spend against your Anthropic
# account. Scope it to a low spend limit, or skip it entirely and import your
# questions from CSV (see QUESTION_FORMAT.md), which needs no key at all.
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Only needed for identity-linked keys, which are rejected with
# "anthropic-workspace-id is required" unless the request names a workspace.
# Find it in the Console URL when viewing the workspace. Leave blank otherwise.
VITE_ANTHROPIC_WORKSPACE_ID=
