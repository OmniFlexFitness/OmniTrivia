{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('meta').child('hostUid').val() === auth.uid || root.child('roomClaims').child($pin).child(auth.uid).exists() || (!newData.exists() && data.child('meta').child('updatedAt').val() < now - 1800000))",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid || root.child('roomClaims').child($pin).child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['hostId', 'hostUid', 'gameName', 'open', 'updatedAt']) && newData.child('hostUid').val() === auth.uid",
          "hostId": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "hostUid": {
            ".validate": "newData.isString()"
          },
          "gameName": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "open": {
            ".validate": "newData.isBoolean()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        },
        "snapshot": {
          ".write": "auth != null && root.child('rooms').child($pin).child('meta').child('hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['from', 'uid', 'at', 'payload'])",
          "from": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "payload": {
            ".validate": "newData.isString() && newData.val().length <= 262144"
          },
          "$other": {
            ".validate": false
          },
          "uid": {
            ".validate": "newData.val() === auth.uid"
          }
        },
        "bus": {
          ".indexOn": "at",
          "$message": {
            ".write": "auth != null && (!data.exists() || root.child('rooms').child($pin).child('meta').child('hostUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['from', 'uid', 'at', 'payload'])",
            "from": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "payload": {
              ".validate": "newData.isString() && newData.val().length <= 65536"
            },
            "$other": {
              ".validate": false
            },
            "uid": {
              ".validate": "newData.val() === auth.uid"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roomSecrets": {
      "$pin": {
        ".write": "auth != null && (root.child('rooms').child($pin).child('meta').child('hostUid').val() === auth.uid || (!newData.exists() && (!root.child('rooms').child($pin).exists() || root.child('rooms').child($pin).child('meta').child('updatedAt').val() < now - 1800000)))",
        ".validate": "newData.hasChildren(['hash'])",
        "hash": {
          ".validate": "newData.isString() && newData.val().length === 64"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roomClaims": {
      "$pin": {
        ".write": "auth != null && (root.child('rooms').child($pin).child('meta').child('hostUid').val() === auth.uid || (!newData.exists() && (!root.child('rooms').child($pin).exists() || root.child('rooms').child($pin).child('meta').child('updatedAt').val() < now - 1800000)))",
        "$uid": {
          ".write": "auth != null && $uid === auth.uid",
          ".validate": "newData.isString() && newData.val() === root.child('roomSecrets').child($pin).child('hash').val()"
        }
      }
    },
    "hostState": {
      "$pin": {
        ".read": "auth != null && (root.child('rooms').child($pin).child('meta').child('hostUid').val() === auth.uid || root.child('roomClaims').child($pin).child(auth.uid).exists())",
        ".write": "auth != null && (root.child('rooms').child($pin).child('meta').child('hostUid').val() === auth.uid || root.child('roomClaims').child($pin).child(auth.uid).exists() || (!newData.exists() && (!root.child('rooms').child($pin).exists() || root.child('rooms').child($pin).child('meta').child('updatedAt').val() < now - 1800000)))",
        ".validate": "newData.hasChildren(['hostId', 'uid', 'at', 'payload'])",
        "hostId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "uid": {
          ".validate": "newData.val() === auth.uid"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "payload": {
          ".validate": "newData.isString() && newData.val().length <= 786432"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
