{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('meta').child('hostUid').val() === auth.uid)",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['hostId', 'hostUid', 'gameName', 'open', 'updatedAt']) && newData.child('hostUid').val() === auth.uid",
          "hostId": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "hostUid": {
            ".validate": "newData.isString()"
          },
          "gameName": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "open": {
            ".validate": "newData.isBoolean()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        },
        "snapshot": {
          ".write": "auth != null && root.child('rooms').child($pin).child('meta').child('hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['from', 'at', 'payload'])",
          "from": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "payload": {
            ".validate": "newData.isString() && newData.val().length <= 262144"
          },
          "$other": {
            ".validate": false
          }
        },
        "bus": {
          ".indexOn": "at",
          "$message": {
            ".write": "auth != null && (!data.exists() || root.child('rooms').child($pin).child('meta').child('hostUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['from', 'at', 'payload'])",
            "from": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "payload": {
              ".validate": "newData.isString() && newData.val().length <= 65536"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
